# Local Docker environment. Copy to .env.docker and replace the four values below.
# Do not copy this file over the existing .env used by the non-Docker application.
MYSQL_DATABASE=restaurant
# Regular application account only; do not set MYSQL_USER=root.
MYSQL_USER=restaurant
MYSQL_PASSWORD=replace-with-a-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Two different Base64-encoded random keys (at least 32 random bytes each).
# See README.md for a PowerShell command that generates them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_DAYS=7

HTTP_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8088
BACKEND_PORT=8081
MYSQL_PORT=3307
MYSQL_VOLUME_NAME=restaurant-local_mysql_data
SWAGGER_ENABLED=true
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://127.0.0.1:8088
# Local schema creation only. Production requires reviewed migrations + validate.
DOCKER_DDL_AUTO=update

# Optional integrations. Uploads need real Cloudinary credentials.
CLOUDINARY_URL=cloudinary://local:local@local-demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=STB
DISCORD_TRANSACTION_WEBHOOK_URL=

# Copy to .env.ec2 on EC2. Never commit that file or copy local credentials blindly.
# Use the exact SHA image tags shown in the successful main-branch publish jobs.
BACKEND_IMAGE=ghcr.io/thanhtrung237/restaurant-backend:sha-REPLACE_WITH_BACKEND_COMMIT
FRONTEND_IMAGE=ghcr.io/thanhtrung237/restaurant-frontend:sha-REPLACE_WITH_FRONTEND_COMMIT

MYSQL_DATABASE=restaurantServiceDB
# Regular application account, not root. Root has its own password below.
MYSQL_USER=restaurant
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_VOLUME_NAME=restaurant-production_mysql_data
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_DAYS=7
CLOUDINARY_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=STB
DISCORD_TRANSACTION_WEBHOOK_URL=

# Phase 1: check FE/API over the EC2 public IP. This is not HTTPS for mobile GPS.
APP_PUBLIC_ORIGIN=http://REPLACE_WITH_EC2_PUBLIC_IP
HTTP_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
TRUST_PROXY_HEADERS=0

# Phase 2, after installing Caddy and pointing a domain to EC2:
# APP_PUBLIC_ORIGIN=https://restaurant.your-domain.com
# HTTP_BIND_ADDRESS=127.0.0.1
# FRONTEND_PORT=8088
# TRUST_PROXY_HEADERS=1

BACKEND_ADMIN_PORT=8081
SWAGGER_ENABLED=false
# Import the matching schema before starting BE. Use reviewed migrations later.
DOCKER_DDL_AUTO=validate
